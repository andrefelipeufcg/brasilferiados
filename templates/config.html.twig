<form method='post' action='{{ form_url }}' id='form_config'>
    <input type='hidden' name='_glpi_csrf_token' value='{{ csrfToken }}'>
    <input type='hidden' name='update_config' value='1'>

    <div class='center' style='margin-top: 20px;'>
        <table class='tab_cadre_fixe' style='width: 700px;'>
            <tr><th colspan='2'>{{ __('Brasil Feriados — Configuração', 'brasilferiados') }}</th></tr>
        </table>
        <hr style='width: 700px; border-top: 3px solid black; margin: 20px auto 10px auto;'>

        <table class='tab_cadre_fixe' style='width: 700px;'>
            <tr><th colspan='2'>{{ __('Provedor', 'brasilferiados') }}</th></tr>
            <tr class='tab_bg_1'>
                <td style='width: 40%; vertical-align: top; padding-top: 15px;'>{{ __('API de Feriados / Importador', 'brasilferiados') }}</td>
                <td>
                    <select name='api_provider' id='api_provider_select' class='form-select' style='width: auto; display: inline-block;'>
                        {% for key, label in providerList %}
                            <option value='{{ key }}' {% if key == apiProvider %}selected='selected'{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                    <br><small class='text-muted'>{{ __('Selecione API / Importador utilizado para buscar feriados.', 'brasilferiados') }}</small>
                </td>
            </tr>

            {% for key, fields in allProviderFields %}
                {% set displayStyle = (key == apiProvider) ? '' : 'style="display: none;"' %}
                
                {% for field in fields %}
                    <tr class='tab_bg_1 provider-field-{{ key }}' {{ displayStyle|raw }}>
                        {% if field.type == 'info' %}
                            <td colspan='2' style='padding: 10px;'>
                                <div style='background: #e8f4fd; border-left: 4px solid #2196F3; padding: 12px 15px; border-radius: 4px;'>
                                    <i class='fas fa-info-circle' style='color: #2196F3;'></i> {{ field.content|raw }}
                                </div>
                            </td>
                        {% else %}
                            <td style='width: 40%; vertical-align: top; padding-top: 15px;'>
                                {{ field.label|raw }} {% if field.required %} <span style='color:red;'>*</span> {% endif %}
                            </td>
                            <td>
                                {% set fieldName = field.name %}
                                {% set val = '' %}
                                {% if fieldName == 'api_token' %}{% set val = apiToken %}{% endif %}
                                {% if fieldName == 'api_uf' %}{% set val = apiUf %}{% endif %}
                                {% if fieldName == 'api_cidade_ibge' %}{% set val = apiCidadeIbge %}{% endif %}
                                {% if fieldName == 'gov_federal_text' %}{% set val = govFederalText %}{% endif %}
                                
                                {% set cssId = field.css_class|default(fieldName ~ '_input') %}
                                {% if fieldName == 'api_uf' %}{% set cssId = 'api_uf_select' %}{% endif %}
                                
                                {% if field.type == 'text' %}
                                    <input type='text' name='{{ fieldName }}' id='{{ cssId }}' value='{{ val }}' class='form-control' style='width: 100%;' placeholder='{{ field.placeholder|default("") }}'>
                                {% elseif field.type == 'textarea' %}
                                    {% set height = field.height|default('150px') %}
                                    <textarea name='{{ fieldName }}' id='{{ cssId }}' class='form-control' style='width: 100%; height: {{ height }};' placeholder='{{ field.placeholder|default("") }}'>{{ val }}</textarea>
                                {% elseif field.type == 'select' %}
                                    <select name='{{ fieldName }}' id='{{ cssId }}' class='form-select' style='width: auto; display: inline-block; min-width: 200px;'>
                                        {% if field.empty_option %}
                                            {% if fieldName == 'api_cidade_ibge' and val != '' %}
                                                <option value='{{ val }}' selected='selected'>Carregando... (IBGE: {{ val }})</option>
                                            {% else %}
                                                <option value=''>{{ field.empty_option }}</option>
                                            {% endif %}
                                        {% endif %}
                                        
                                        {% if field.options %}
                                            {% for optVal, optLabel in field.options %}
                                                <option value='{{ optVal }}' {% if optVal == val %}selected='selected'{% endif %}>{{ optVal ~ ' — ' ~ optLabel }}</option>
                                            {% endfor %}
                                        {% endif %}
                                    </select>
                                {% endif %}
                                
                                {% if field.help_text %}
                                    <br><small class='text-muted'>{{ field.help_text|raw }}</small>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            {% endfor %}
            
            <tr class='tab_bg_2'>
                <td colspan='2' class='center' style='padding: 10px;'>
                    <button type='submit' class='btn btn-secondary'>{{ __('Salvar configurações de provedor', 'brasilferiados') }}</button>
                </td>
            </tr>
        </table>
        
        <hr style='width: 700px; border-top: 3px solid black; margin: 20px auto 10px auto;'>
        
        <table class='tab_cadre_fixe' style='width: 700px;'>
            <tr><th colspan='2'>{{ __('Sincronização Automática', 'brasilferiados') }}</th></tr>
            <tr class='tab_bg_1'>
                <td style='width: 40%; vertical-align: top; padding-top: 15px;'>{{ __('Sincronização automática de Ano Novo', 'brasilferiados') }}</td>
                <td>
                    <label>
                        <input type='checkbox' name='is_active' value='1' {% if isActive %}checked='checked'{% endif %}> 
                        {{ __('Executar sincronização automaticamente em 1º de Janeiro do ano corrente via GLPI Cron', 'brasilferiados') }}
                        <br><small class='text-muted'>
                            {{ __('Exemplo: no dia 1º de janeiro de 2030, será criado um calendário na entidade raiz do GLPI com o nome "Calendário 2030". Esse calendário terá os feriados obtidos via <strong>%1$s</strong> e os feriados locais recorrentes cadastrados pelo usuário.', 'brasilferiados')|format(providerLabel)|raw }}
                        </small>
                    </label>
                </td>
            </tr>
            <tr class='tab_bg_2'>
                <td colspan='2' class='center' style='padding: 10px;'>
                    <button type='submit' class='btn btn-secondary'>{{ __('Salvar', 'brasilferiados') }}</button>
                </td>
            </tr>
        </table>
        
        <hr style='width: 700px; border-top: 3px solid black; margin: 20px auto 10px auto;'>
        
        <table class='tab_cadre_fixe' style='width: 700px;'>
            <tr><th colspan='2'>{{ __('Sincronização Manual', 'brasilferiados') }}</th></tr>
        </table>
    </div>
</form>

<div class='center' style='margin-top: 20px;'>
    <form method='post' action='{{ form_url }}' style='margin-bottom: 0;'>
        <input type='hidden' name='_glpi_csrf_token' value='{{ csrfToken }}'>
        <input type='hidden' name='load_national' value='1'>

        <table class='tab_cadre_fixe' style='width: 700px;'>
            <tr class='tab_bg_2'>
                <th colspan='4' style='text-align: left; padding: 10px;'>
                    {{ __('Feriados do ano', 'brasilferiados') }}
                    <input type='number' name='load_year' id='sync_year_input' value='{{ loadedYear }}' min='2001' max='2099' style='width: 90px; margin-left: 10px;' class='form-control d-inline-block'>
                    <button type='submit' class='btn btn-warning' style='margin-left: 10px; color: white;'>{{ __('Carregar Feriados', 'brasilferiados') }}</button>
                    <span style='margin-left: 15px; font-weight: normal; font-size: 0.85em; color: #666;'>
                        <i class='fas fa-plug'></i> {{ __('Provedor', 'brasilferiados') }}: <strong>{{ providerLabel }}</strong>
                    </span>
                </th>
            </tr>

            <tr class='tab_bg_2'>
                <th style='width: 20%; text-align: center;'>{{ __('Data', 'brasilferiados') }}</th>
                <th style='text-align: left;'>{{ __('Nome do Feriado', 'brasilferiados') }}</th>
                <th style='width: 15%; text-align: center;'>{{ __('Recorrente', 'brasilferiados') }}</th>
                <th style='width: 15%; text-align: center;'>{{ __('Ações', 'brasilferiados') }}</th>
            </tr>
            
            {% if not isLoaded %}
                <tr class='tab_bg_1'>
                    <td colspan='4' class='center' style='padding: 20px; color: #888;'>
                        <i class='fas fa-info-circle'></i> {{ __('Clique em \'Carregar Feriados\' para visualizar e remover os indesejados.', 'brasilferiados') }}
                    </td>
                </tr>
            {% elseif apiHolidays is empty %}
                <tr class='tab_bg_1'>
                    <td colspan='4' class='center' style='padding: 20px; color: #888;'>
                        <i class='fas fa-info-circle'></i> {{ __('Nenhum feriado encontrado via %1$s para o ano %2$d.', 'brasilferiados')|format(providerLabel, loadedYear) }}
                    </td>
                </tr>
            {% else %}
                {% for idx, f in apiHolidays %}
                    {% set dataOrig = f.date %}
                    {% set partes = dataOrig|split('-') %}
                    {% set dataFormatada = (partes|length == 3) ? (partes[2] ~ '/' ~ partes[1]) : dataOrig %}
                    
                    {% set isPerpetual = f.is_perpetual ?? null %}
                    {% if isPerpetual is null %}
                        {% set feriadosMoveis = ['Carnaval', 'Sexta-feira Santa', 'Páscoa', 'Corpus Christi'] %}
                        {% set isPerpetual = true %}
                        {% for movel in feriadosMoveis %}
                            {% if movel|lower in f.name|lower %}
                                {% set isPerpetual = false %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    
                    {% set textoRecorrente = isPerpetual ? __('Sim', 'brasilferiados') : __('Não', 'brasilferiados') %}
                    {% set isPerpetualInt = isPerpetual ? 1 : 0 %}
                    
                    <tr class='tab_bg_1' id='row_nat_{{ idx }}'>
                        <td class='center'><strong>{{ dataFormatada }}</strong></td>
                        <td id='name_nat_{{ idx }}'>{{ f.name }}</td>
                        <td class='center' id='rec_nat_{{ idx }}'>{{ textoRecorrente }}</td>
                        <td class='center' style='white-space: nowrap;'>
                            <button type="button" class="btn btn-sm btn-outline-primary" title="Editar" style="margin-right: 5px;" onclick="abrirModalFeriadoNacional({{ idx }}, '{{ dataFormatada }}', {{ f.name|json_encode|escape('html_attr') }}, {{ isPerpetualInt }})">
                                <i class='fas fa-edit'></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Excluir" onclick="removerFeriadoNacional({{ idx }})">
                                <i class='fas fa-trash-alt'></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
        </table>
    </form>
</div>

<div class='center' style='margin-top: 20px;'>
    <table class='tab_cadre_fixe' style='width: 700px;'>
        <tr><th colspan='4'>{{ __('Feriados Locais', 'brasilferiados') }}</th></tr>
        <tr class='tab_bg_2'>
            <th style='width: 20%; text-align: center;'>{{ __('Data', 'brasilferiados') }}</th>
            <th style='text-align: left;'>{{ __('Nome do Feriado', 'brasilferiados') }}</th>
            <th style='width: 15%; text-align: center;'>{{ __('Recorrente', 'brasilferiados') }}</th>
            <th style='width: 20%; text-align: center;'>{{ __('Ações', 'brasilferiados') }}</th>
        </tr>
        
        {% if feriadosLocais is empty %}
            <tr class='tab_bg_1'>
                <td colspan='4' class='center' style='padding: 20px; color: #888;'>
                    <i class='fas fa-info-circle'></i> {{ __('Nenhum feriado local cadastrado.', 'brasilferiados') }}
                </td>
            </tr>
        {% else %}
            {% for fl in feriadosLocais %}
                {% set dataFormatada = '%02d/%02d'|format(fl.dia, fl.mes) %}
                {% set is_perpetual = fl.is_perpetual ?? 1 %}
                
                <tr class='tab_bg_1'>
                    <td class='center'><strong>{{ dataFormatada }}</strong></td>
                    <td>{{ fl.nome }}</td>
                    <td class='center'>{{ is_perpetual ? __('Sim', 'brasilferiados') : __('Não', 'brasilferiados') }}</td>
                    <td class='center' style='white-space: nowrap;'>
                        <button type="button" class="btn btn-sm btn-outline-primary" title="Editar" style="margin-right: 5px;" onclick="abrirModalFeriado({{ fl.id }}, {{ fl.dia }}, {{ fl.mes }}, {{ fl.nome|json_encode|escape('html_attr') }}, {{ is_perpetual }})">
                            <i class='fas fa-edit'></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" title="Excluir" onclick="excluirFeriadoLocal({{ fl.id }}, {{ fl.nome|json_encode|escape('html_attr') }})">
                            <i class='fas fa-trash-alt'></i>
                        </button>
                    </td>
                </tr>
            {% endfor %}
        {% endif %}
        
        <tr class='tab_bg_2'>
            <td colspan='4' class='center' style='padding: 10px;'>
                <button type='button' class='btn btn-success' onclick='abrirModalFeriado(0, "", "", "", 1)'>
                    <i class='fas fa-plus'></i> {{ __('Adicionar Feriado Local', 'brasilferiados') }}
                </button>
            </td>
        </tr>
    </table>
</div>

<form method='post' action='{{ form_url }}' id='form_sync_manual'>
    <input type='hidden' name='_glpi_csrf_token' value='{{ csrfToken }}'>
    <div id='national_holidays_container' style='display: none;'>
        {% if isLoaded and apiHolidays is not empty %}
            {% for idx, f in apiHolidays %}
                {% set isP = f.is_perpetual ?? 1 %}
                {% if f.is_perpetual is null %}
                    {% set feriadosMoveis = ['Carnaval', 'Sexta-feira Santa', 'Páscoa', 'Corpus Christi'] %}
                    {% for movel in feriadosMoveis %}
                        {% if movel|lower in f.name|lower %}
                            {% set isP = 0 %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
                <div id='hidden_nat_{{ idx }}'>
                    <input type='hidden' name='national_holidays[{{ idx }}][date]' value='{{ f.date }}'>
                    <input type='hidden' id='hidden_name_nat_{{ idx }}' name='national_holidays[{{ idx }}][name]' value='{{ f.name }}'>
                    <input type='hidden' id='hidden_rec_nat_{{ idx }}' name='national_holidays[{{ idx }}][is_perpetual]' value='{{ isP }}'>
                </div>
            {% endfor %}
        {% endif %}
        
        {% if isLoaded %}
            <input type='hidden' name='loaded_year' value='{{ loadedYear }}'>
        {% endif %}
    </div>

    <div class='center' style='margin-top: 20px;'>
        <table class='tab_cadre_fixe' style='width: 700px; margin-bottom: 20px;'>
            <tr class='tab_bg_1'>
                <td style='width: 40%; vertical-align: top; padding-top: 15px;'>{{ __('Calendário Principal de Atendimento', 'brasilferiados') }} <span style='color:red;'>*</span></td>
                <td>
                    {{ calendarDropdown|raw }}
                    <br><small class='text-muted'>{{ __('Os feriados serão vinculados a este calendário durante a Sincronização Manual.', 'brasilferiados') }}</small>
                </td>
            </tr>
        </table>

        <input type='hidden' name='sync_year' id='hidden_sync_year' value='{{ loadedYear }}'>
        <button type='button' class='btn btn-secondary' onclick='validarSincronizacao()' style='color: white;'>{{ __('Sincronizar Agora', 'brasilferiados') }}</button>
        <input type='hidden' name='manual_calendars_id' id='hidden_manual_cal' value='0'>
        <input type='submit' name='sync_now' id='real_sync_btn' style='display: none;'>
        <hr style='width: 700px; border-top: 3px solid black; margin: 20px auto 50px auto;'>
    </div>
</form>

<form method='post' action='{{ local_form_url }}' id='form_delete_local' style='display:none;'>
    <input type='hidden' name='_glpi_csrf_token' value='{{ csrfToken }}'>
    <input type='hidden' name='id' id='delete_local_id' value='0'>
    <input type='hidden' name='delete_local' value='1'>
</form>

<script>
(function() {
    var providerSelect = document.getElementById('api_provider_select');
    if (!providerSelect) return;

    function toggleProviderFields() {
        var provider = providerSelect.value;
        var allProviderFields = document.querySelectorAll('[class*="provider-field-"]');
        
        for (var i = 0; i < allProviderFields.length; i++) {
            allProviderFields[i].style.display = 'none';
        }
        
        var activeFields = document.querySelectorAll('.provider-field-' + provider);
        for (var j = 0; j < activeFields.length; j++) {
            activeFields[j].style.display = '';
            activeFields[j].style.opacity = '0';
            activeFields[j].style.transition = 'opacity 0.3s ease-in';
            setTimeout((function(el) {
                return function() { el.style.opacity = '1'; };
            })(activeFields[j]), 50);
        }
    }

    providerSelect.addEventListener('change', toggleProviderFields);
})();

(function() {
    var ufSelect = document.getElementById('api_uf_select');
    var cidadeSelect = document.getElementById('api_cidade_select');
    var savedIbge = {{ apiCidadeIbge|json_encode|raw }};
    var savedUf = {{ apiUf|json_encode|raw }};

    if (!ufSelect || !cidadeSelect) return;

    function carregarCidades(uf, preSelectIbge) {
        if (!uf) {
            cidadeSelect.innerHTML = '<option value="">' + {{ __("Selecione o estado primeiro...", "brasilferiados")|json_encode|raw }} + '</option>';
            return;
        }

        cidadeSelect.innerHTML = '<option value="">' + {{ __("Carregando cidades...", "brasilferiados")|json_encode|raw }} + '</option>';
        cidadeSelect.disabled = true;

        var url = 'https://servicodados.ibge.gov.br/api/v1/localidades/estados/' + uf + '/municipios?orderBy=nome';

        var capitais = {
            'AC': 'Rio Branco', 'AL': 'Maceió', 'AP': 'Macapá', 'AM': 'Manaus',
            'BA': 'Salvador', 'CE': 'Fortaleza', 'DF': 'Brasília', 'ES': 'Vitória',
            'GO': 'Goiânia', 'MA': 'São Luís', 'MT': 'Cuiabá', 'MS': 'Campo Grande',
            'MG': 'Belo Horizonte', 'PA': 'Belém', 'PB': 'João Pessoa', 'PR': 'Curitiba',
            'PE': 'Recife', 'PI': 'Teresina', 'RJ': 'Rio de Janeiro', 'RN': 'Natal',
            'RS': 'Porto Alegre', 'RO': 'Porto Velho', 'RR': 'Boa Vista', 'SC': 'Florianópolis',
            'SP': 'São Paulo', 'SE': 'Aracaju', 'TO': 'Palmas'
        };

        fetch(url)
            .then(function(response) { return response.json(); })
            .then(function(municipios) {
                cidadeSelect.innerHTML = '<option value="">' + {{ __("Selecione a cidade...", "brasilferiados")|json_encode|raw }} + '</option>';
                var capitalNome = capitais[uf];
                for (var i = 0; i < municipios.length; i++) {
                    var m = municipios[i];
                    var opt = document.createElement('option');
                    opt.value = m.id;
                    opt.textContent = m.nome;
                    if (preSelectIbge && String(m.id) === String(preSelectIbge)) {
                        opt.selected = true;
                    } else if (!preSelectIbge && m.nome === capitalNome) {
                        opt.selected = true;
                    }
                    cidadeSelect.appendChild(opt);
                }
                cidadeSelect.disabled = false;
            })
            .catch(function(err) {
                cidadeSelect.innerHTML = '<option value="">' + {{ __("Erro ao carregar cidades", "brasilferiados")|json_encode|raw }} + '</option>';
                cidadeSelect.disabled = false;
                console.error('Erro ao carregar municípios do IBGE:', err);
            });
    }

    ufSelect.addEventListener('change', function() {
        carregarCidades(this.value, null);
    });

    if (savedUf) {
        carregarCidades(savedUf, savedIbge);
    }
})();

(function() {
    var formConfig = document.getElementById('form_config');
    if (!formConfig) return;

    formConfig.addEventListener('submit', function(e) {
        var providerSelect = document.getElementById('api_provider_select');
        if (!providerSelect) return;
        
        var provider = providerSelect.value;
        var isValid = true;
        
        var rows = document.querySelectorAll('.provider-field-' + provider);
        for (var i = 0; i < rows.length; i++) {
            var labelCell = rows[i].querySelector('td:first-child');
            if (labelCell && labelCell.innerHTML.indexOf('*') !== -1) {
                var input = rows[i].querySelector('input, select, textarea');
                if (input && input.value.trim() === '') {
                    isValid = false;
                    break;
                }
            }
        }
        
        if (!isValid) {
            e.preventDefault();
            alert({{ __("Por favor, preencha todos os campos obrigatórios (*) do provedor selecionado.", "brasilferiados")|json_encode|raw }});
        }
    });
})();

function removerFeriadoNacional(idx) {
    var row = document.getElementById('row_nat_' + idx);
    if (row) { row.remove(); }
    
    var hiddenDiv = document.getElementById('hidden_nat_' + idx);
    if (hiddenDiv) { hiddenDiv.remove(); }
}

function excluirFeriadoLocal(id, nome) {
    var msg = {{ __('Tem certeza que deseja excluir o feriado local', 'brasilferiados')|json_encode|raw }};
    if (confirm(msg + " '" + nome + "'?")) {
        document.getElementById('delete_local_id').value = id;
        document.getElementById('form_delete_local').submit();
    }
}

function validarSincronizacao() {
    var loadedYear = {{ isLoaded ? loadedYear : 0 }};
    var syncYearInput = document.getElementById('sync_year_input').value;
    document.getElementById('hidden_sync_year').value = syncYearInput;
    var isActive = {{ isActive ? 1 : 0 }};
    
    if (isActive === 0) {
        if (loadedYear === 0) {
            alert({{ __('Você deve Carregar os Feriados do ano desejado antes de sincronizar.', 'brasilferiados')|json_encode|raw }});
            return false;
        }
        
        if (parseInt(syncYearInput) !== loadedYear) {
            alert({{ __('Atenção: O ano digitado na Sincronização é diferente do ano carregado no Grid.\n\nPor favor, atualize o ano no campo Feriados do ano, clique em Carregar Feriados e tente novamente.', 'brasilferiados')|json_encode|raw }});
            return false;
        }
    }

    var calDropdown = document.querySelector("select[name='calendars_id']");
    var currentCalId = 0;
    if (calDropdown && calDropdown.value) {
        currentCalId = parseInt(calDropdown.value);
    }
    
    if (isNaN(currentCalId) || currentCalId === 0) {
        alert({{ __('O Calendário Principal de Atendimento é obrigatório para a sincronização manual.\n\nPor favor, selecione-o no menu dropdown abaixo e tente novamente.', 'brasilferiados')|json_encode|raw }});
        return false;
    }
    document.getElementById('hidden_manual_cal').value = currentCalId;
    
    if (confirm({{ __('Prosseguir com a Sincronização Manual?', 'brasilferiados')|json_encode|raw }})) {
        var hiddenSubmit = document.createElement('input');
        hiddenSubmit.type = 'hidden';
        hiddenSubmit.name = 'sync_now';
        hiddenSubmit.value = '1';
        var form = document.getElementById('form_sync_manual');
        form.appendChild(hiddenSubmit);
        form.submit();
    }
}

function abrirModalFeriado(id, dia, mes, nome, isPerpetual) {
    document.getElementById('modal_fl_id').value = id;
    document.getElementById('modal_fl_dia').value = dia;
    document.getElementById('modal_fl_mes').value = mes;
    document.getElementById('modal_fl_nome').value = nome;
    document.getElementById('modal_fl_perpetual').checked = (isPerpetual == 1);
    
    document.getElementById('modalFeriadoLocalLabel').innerText = (id > 0) ? {{ __("Editar Feriado Local", "brasilferiados")|json_encode|raw }} : {{ __("Novo Feriado Local", "brasilferiados")|json_encode|raw }};
    
    var modalEl = document.getElementById('modalFeriadoLocal');
    if (typeof bootstrap !== 'undefined') {
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
    } else {
        $(modalEl).modal('show');
    }
}

function abrirModalFeriadoNacional(idx, dataFormatada, nomeAtual, isPerpetual) {
    document.getElementById('modal_nat_idx').value = idx;
    document.getElementById('modal_nat_data').value = dataFormatada;
    document.getElementById('modal_nat_nome').value = nomeAtual;
    document.getElementById('modal_nat_perpetual').checked = (isPerpetual == 1);
    
    var modalEl = document.getElementById('modalFeriadoNacional');
    if (typeof bootstrap !== 'undefined') {
        var modal = new bootstrap.Modal(modalEl);
        modal.show();
    } else {
        $(modalEl).modal('show');
    }
}

function salvarEdicaoNacional() {
    var idx = document.getElementById('modal_nat_idx').value;
    var novoNome = document.getElementById('modal_nat_nome').value;
    var isPerpetual = document.getElementById('modal_nat_perpetual').checked ? 1 : 0;
    
    document.getElementById('name_nat_' + idx).innerText = novoNome;
    document.getElementById('hidden_name_nat_' + idx).value = novoNome;
    
    var recText = (isPerpetual == 1) ? {{ __("Sim", "brasilferiados")|json_encode|raw }} : {{ __("Não", "brasilferiados")|json_encode|raw }};
    document.getElementById('rec_nat_' + idx).innerText = recText;
    document.getElementById('hidden_rec_nat_' + idx).value = isPerpetual;
    
    var modalEl = document.getElementById('modalFeriadoNacional');
    if (typeof bootstrap !== 'undefined') {
        var modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
    } else {
        $(modalEl).modal('hide');
    }
}
</script>

